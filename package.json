{
  "name": "@redrockswebdevelopment/formstack-documents-api-connector",
  "version": "1.1.2",
  "description": "Type-safe Node, Hono, MCP, and CLI connector for the Formstack Documents (Webmerge) API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "formstack-documents": "dist/cli.js",
    "formstack-documents-mcp": "dist/mcp.js",
    "webmerge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "test": "pnpm run test:unit && pnpm run build && pnpm run test:package",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:package": "node --import tsx --test --test-concurrency=1 tests/package/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "pnpm run typecheck && pnpm test",
    "prebuild": "node -e \"require(\\\"node:fs\\\").rmSync(\\\"dist\\\", { recursive: true, force: true })\"",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run validate"
  },
  "keywords": [
    "formstack",
    "webmerge",
    "documents",
    "api",
    "hono",
    "cli"
  ],
  "author": "Andrew Kepson",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewKepson/formstack-documents-api-connector.git"
  },
  "homepage": "https://github.com/AndrewKepson/formstack-documents-api-connector#readme",
  "bugs": {
    "url": "https://github.com/AndrewKepson/formstack-documents-api-connector/issues"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@hono/zod-validator": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "hono": "^4.12.31",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "packageManager": "pnpm@11.15.1"
}
