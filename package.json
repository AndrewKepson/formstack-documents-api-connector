{
  "name": "formstack-documents-api-connector",
  "version": "1.0.0",
  "description": "Type-safe Node, Express, and CLI connector for the Formstack Documents (Webmerge) API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "formstack-documents": "dist/cli.js",
    "webmerge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "formstack",
    "webmerge",
    "documents",
    "api",
    "express",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
